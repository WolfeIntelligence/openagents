# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenAgents
.env
.env.local
cli/node_modules
# drizzle/ migrations are tracked (see docs/SETUP.md); only drizzle-kit's scratch output is not.
drizzle/*.tmp

.vercel
.env*

# Vendor agent skills installed by `vercel integration add`
.agents/
.claude/skills/
skills-lock.json

# local scratch (one-off repair/inspection scripts)
.tmp/

# temporary env pulls (e.g. `vercel env pull` for one-off smoke tests) — already covered
# by `.env*` above, listed explicitly for clarity
.env*.tmp

# Keep the documented template even though real env files are ignored above.
!.env.example

# CLI tarball generated at build time by scripts/pack-cli.mjs
public/cli/
