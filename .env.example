# OpenAgents runs with zero environment variables set — the seed catalog, docs, and
# CLI/API all work with none of this filled in. Every variable below is optional and
# turns on one additional layer (database, then auth, then payments); copy this file to
# .env.local and fill in only what you need. See docs/SETUP.md and
# src/content/docs/self-hosting.md for the full walkthrough of each section.

# ---------------------------------------------------------------------------
# Database (Neon Postgres) — enables the DB-backed catalog, publishing, purchases, stars
# ---------------------------------------------------------------------------

# Postgres connection string. Provision via the Vercel Marketplace → Neon integration,
# or directly at https://neon.tech. Unset: only the bundled seed catalog is served.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth.js (GitHub and/or Google OAuth) — enables sign-in, publishing, stars
# ---------------------------------------------------------------------------

# Random 32+ byte secret signing session/JWT cookies, shared by both providers.
# Generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=

# GitHub OAuth App client id (github.com/settings/developers).
AUTH_GITHUB_ID=

# GitHub OAuth App client secret.
AUTH_GITHUB_SECRET=

# Google OAuth client id (console.cloud.google.com → APIs & Services → Credentials).
AUTH_GOOGLE_ID=

# Google OAuth client secret.
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Stripe Connect — enables paid packages, checkout, and seller payouts
# ---------------------------------------------------------------------------

# Secret key from the Stripe dashboard (dashboard.stripe.com/apikeys). Use a
# restricted or test-mode key while developing.
STRIPE_SECRET_KEY=

# Signing secret for the /api/webhooks/stripe endpoint — from `stripe listen`
# locally, or the Dashboard webhook configuration in production.
STRIPE_WEBHOOK_SECRET=

# Platform fee in basis points taken from each paid sale. Optional, defaults to
# 1000 (10%) when unset.
PLATFORM_FEE_BPS=

# ---------------------------------------------------------------------------
# Moderation and review
# ---------------------------------------------------------------------------

# Comma-separated handles granted admin/moderation access, in addition to any
# user with users.isAdmin set directly in the database. Optional — with neither
# set, /admin and the admin API routes are inaccessible to everyone.
ADMIN_HANDLES=

# Set to "1" to require admin approval before a newly published package goes
# live: new packages are created with status "pending" (visible only to their
# owner) until approved from /admin. Optional, defaults to off (packages publish
# straight to "live", as today). Publishing a new version of an already-live
# package is unaffected either way.
REQUIRE_REVIEW=

# ---------------------------------------------------------------------------
# Email notifications (Resend) — purchase receipts, sale/report/status emails
# ---------------------------------------------------------------------------

# Resend API key (resend.com). Without it, notification sending is a no-op —
# nothing breaks, emails just don't go out.
RESEND_API_KEY=

# The "From" address used for every email this deployment sends, e.g.
# "OpenAgents <notifications@yourdomain.com>". Required alongside
# RESEND_API_KEY for email to actually go out.
EMAIL_FROM=

# Where report notifications are sent. Optional even with the two above set —
# only the admin-facing report email is skipped without it.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# GitHub auto-sync — republish a package automatically on a linked repo's
# release or tag push
# ---------------------------------------------------------------------------

# Signing key for verifying inbound GitHub webhook requests
# (POST /api/webhooks/github/{id}). Optional — falls back to AUTH_SECRET when
# unset, so a deployment with auth already configured needs nothing extra here.
SOURCE_WEBHOOK_KEY=

# ---------------------------------------------------------------------------
# Cron jobs (rollups, cleanup, review reminders)
# ---------------------------------------------------------------------------

# Bearer token required by the /api/cron/* routes (rollup-downloads, cleanup,
# review-reminders) — Authorization: Bearer <CRON_SECRET>. Without it, those
# routes 401 and never run. Vercel's Cron scheduler (see vercel.json) sends this
# automatically on the hosted deployment.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# Salt mixed into the per-day client hash used to dedupe download counts (see
# src/lib/analytics.ts). Optional — without it, downloads are still deduped
# per-client-per-day, just with a less secret hash (the UTC day alone still
# prevents joining the hash across days). Rotate this to invalidate all
# existing per-day dedupe hashes at once.
DOWNLOAD_HASH_SALT=

# ---------------------------------------------------------------------------
# Error monitoring (optional — see src/instrumentation.ts, src/lib/monitoring.ts)
# ---------------------------------------------------------------------------

# Sentry DSN (from a Sentry project's Client Keys settings), e.g.
# https://<publicKey>@<host>/<projectId>. Optional — every server error is always
# logged as structured JSON to stderr regardless of this variable; when it's set,
# the same error is also POSTed to Sentry's ingest endpoint directly (no SDK
# dependency), best-effort, with a 2-second timeout that never delays a response.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public base URL used for canonical links, the sitemap, OG images, and Stripe/OAuth
# redirects. Optional — falls back to the Vercel production URL, then localhost, when
# unset.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# CLI (cli/) — not read by the Next.js app; only used when running the CLI from source
# ---------------------------------------------------------------------------

# Default registry base URL for every CLI command; overridden per-invocation by
# --registry. Defaults to the hosted instance when unset.
OPENAGENTS_REGISTRY=
